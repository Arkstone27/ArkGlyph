* { 
    font-family: "JetBrains Mono";
}


QFrame {
    background: #0e0e11
}

QFrame#Trans {
    background: transparent;
}

QLabel#Titre {
    background: transparent;
    font-size: 18px;
    color: #ededee;
}

QLabel#titre {
    background: transparent;
    font-size: 16px;
    color: #ededee;
}

QLabel#texte {
    background: transparent;
    font-size: 16px;
    color: #69696f;
}

QPushButton {
    background: #18181b;
    color: #69696f;

    border-radius: 6px;
    border: 1px solid #232326;

    height: 34px;
    min-width: 22px;
    font-size: 16px;
    padding-left: 6px;
    padding-right: 6px;
}

QPushButton::hover {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0.273, stop:0 #303035, stop:1 #18181b);
    border: 1px solid #7b55fd;
}

QToolTip {
    background: #0e0e11;
    color: #69696f;
    border: none;

    font-size: 14px;
}

QLineEdit {
    background: #18181b;
    font-size: 16px;
    color: #69696f;

    border: 1px solid #232326;
    border-radius: 6px;

    height: 34px;
}

QLineEdit:hover {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0.273, stop:0 #303035, stop:1 #18181b);
    border: 1px solid #7b55fd;
}

QPushButton#Trans {
    background: transparent;
    color: #69696f;
    border: none;

    height: 34px;
    min-width: 22px;
    font-size: 16px;
    padding-left: 6px;
    padding-right: 6px;
}

QPushButton#Trans::hover {
    background: #303035;
    border: 1px solid transparent;
    border-radius: 6px;
}

QPushButton#Red {
    background: transparent;
    color: #69696f;

    border-radius: 6px;
    border: 1px solid #f36259;

    height: 34px;
    min-width: 22px;
    font-size: 16px;
    padding-left: 6px;
    padding-right: 6px;
}

QPushButton#Red::hover {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0.273, stop:0 #303035, stop:1 #18181b);
}

QScrollBar {
    background: #18181b;
    border-left: 1px solid #303035;
    border-radius: 6px;
}

QScrollBar::handle {
    background: #303035;
    border-radius: 6px;
}

QScrollBar::handle:hover {
    border: 1px solid #232326;
    background: #303035;
}

QScrollBar:horizontal {
    height: 14px;
}

QScrollBar:vertical {
    width: 14px;
}

QScrollBar::add-line, QScrollBar::sub-line {
    height: 0px;

}

QTabBar::tab {
    background: transparent;
    border: none;
    color: #69696f;

    height: 34px;
    min-width: 68px;
    font-size: 16px;

    margin-right: 2px;
    padding-right: 18px;
    padding-left: 18px;
}

QTabBar {
    border: none;
    background: transparent;
    qproperty-drawBase: 0;
}

QTabBar::tab::hover {
    background: #303035;
    border: 1px solid transparent;
    border-radius: 6px;
}

QTabBar::tab::selected {
    background: #303035;
    border: 1px solid #7b55fd;
    border-radius: 6px;
}

QFrame#Ajout, QGraphicsView {
    background: #18181b;
    border: 2px solid #232326;
    border-radius: 6px;
    margin-left: 6px;
}

QListWidget {
    background: transparent;
    border: 1px solid #303035;
    border-radius: 6px;
}

QListWidget::item {
    border-bottom: 1px solid #303035;
}

QListWidget::item:selected, QListWidget::item:hover {
    background: #303035;
}
