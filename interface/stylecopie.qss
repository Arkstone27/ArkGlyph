* { 
    font-family: "JetBrains Mono";
}


QFrame {
    background: pbgdark;
}

QFrame#Trans {
    background: transparent;
}

QLabel#Titre {
    background: transparent;
    font-size: 18px;
    color: ptextsimple;
}

QLabel#titre {
    background: transparent;
    font-size: 16px;
    color: ptextsimple;
}

QLabel#titre:disabled {
    color: ptextmuted;
}

QLabel#texte {
    background: transparent;
    font-size: 16px;
    color: ptextmuted;
}

QPushButton {
    background: pbgall;
    color: ptextmuted;

    border-radius: 6px;
    border: 1px solid pborder;

    height: 34px;
    min-width: 22px;
    font-size: 16px;
    padding-left: 6px;
    padding-right: 6px;
}

QPushButton::hover {
    background: pgradient;
    border: 1px solid pprimlight;
}

QToolTip {
    background: pbgdark;
    color: ptextmuted;
    border: none;

    font-size: 14px;
}

QLineEdit {
    background: pbgall;
    font-size: 16px;
    color: ptextmuted;

    border: 1px solid pborder;
    border-radius: 6px;

    height: 34px;
}

QLineEdit:hover {
    background: pgradient;
    border: 1px solid pprimlight;
}

QPushButton#Trans {
    background: transparent;
    color: ptextmuted;
    border: none;

    height: 34px;
    min-width: 22px;
    font-size: 16px;
    padding-left: 6px;
    padding-right: 6px;
}

QPushButton#Trans::hover {
    background: pbglight;
    border: 1px solid transparent;
    border-radius: 6px;
}

QPushButton#Red {
    background: transparent;
    color: ptextmuted;

    border-radius: 6px;
    border: 1px solid pred;

    height: 34px;
    min-width: 22px;
    font-size: 16px;
    padding-left: 6px;
    padding-right: 6px;
}

QPushButton#Red::hover {
    background: pgradient;
}

QScrollBar {
    background: pbgall;
    border-left: 1px solid pseparator;
    border-radius: 6px;
}

QScrollBar::sub-page, QScrollBar::add-page {
    background: transparent;
}

QScrollBar::handle {
    background: pbglight;
    border-radius: 6px;
}

QScrollBar::handle:hover {
    border: 1px solid pborder;
    background: pseparator;
}

QScrollBar:horizontal {
    height: 14px;
}

QScrollBar:vertical {
    width: 14px;
}

QScrollBar::add-line, QScrollBar::sub-line {
    height: 0px;
}

QTabBar::tab {
    background: transparent;
    border: none;
    color: ptextsimple;

    height: 34px;
    min-width: 68px;
    font-size: 16px;

    margin-right: 2px;
    padding-right: 18px;
    padding-left: 18px;
}

QTabBar {
    border: none;
    background: transparent;
    qproperty-drawBase: 0;
}

QTabBar::tab::hover {
    background: pbglight;
    border: 1px solid transparent;
    border-radius: 6px;
}

QTabBar::tab::selected {
    background: pbglight;
    border: 1px solid pprimlight;
    border-radius: 6px;
}

QFrame#Ajout, QGraphicsView {
    background: pbgall;
    border: 2px solid pborder;
    border-radius: 6px;
    margin-left: 6px;
}

QListWidget {
    background: transparent;
    border: 1px solid pseparator;
    border-radius: 6px;
}

QListWidget::item {
    border-bottom: 1px solid pseparator;
}

QListWidget::item:selected, QListWidget::item:hover {
    background: pbglight;
}

QSpinBox#Pages {
    background: rgba(19, 19, 21, 150);
    font-size: 16px;
    color: ptextsimple;
    border-radius: 6px;

    padding-right: 5px;
    padding-left: 5px;
    margin-bottom: 10px;
}

QSpinBox#Pages::down-button:hover, QSpinBox#Pages::up-button:hover {
    bottom: 2px;
}

QSpinBox#Pages::down-button {
    subcontrol-origin: border;
    subcontrol-position: center left;
    width: 20px;
    height: 20px;

    background: transparent;
    left: 5px;

    padding: 5px;
    border-radius: 6px;
}

QSpinBox#Pages::up-button {
    subcontrol-origin: border;
    subcontrol-position: center right;
    width: 20px;
    height: 20px;

    background: transparent;
    right: 5px;

    padding: 5px;
    border-radius: 6px;
}

QSpinBox#Pages::up-arrow {
    image: url("interface/resources/dark-icons/next.svg");
    width: 20px;
    height: 20px;
}

QSpinBox#Pages::down-arrow {
    image: url("interface/resources/dark-icons/previous.svg");
    width: 20px;
    height: 20px;
}

QFrame#SideBarOutils {
    margin-top: 8px;
}

QGraphicsView QScrollBar:vertical {
    width: 0px;
}

QLineEdit#Type {
    color: ptextsimple;
}

QMenu {
    background: pborder;
    padding: 5px;
}

QMenu::separator {
    background: pseparator;
    height: 2px;

}

QMenu::item {
    padding-left: 5px;
    padding-right: 20px;
    font-size: 16px;
    color: ptextsimple;
}

QMenu::item:selected {
    background: pbglight;
    padding-left: 10px;
    padding-right: 5px;

    border: 2px solid transparent;
    border-radius: 6px;
}

QListWidget#Process {
    background: transparent;
    border: none;
}

QListWidget#Process::item {
    background: rgba(24, 24, 27, 200);
    border: 1px solid pborder;
    border-radius: 6px;

    margin: 5px;
    padding: 5px;
}

QListWidget#Process::item QFrame {
    background: transparent;
}